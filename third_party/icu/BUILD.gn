import("../../gn/skia.gni")
import("../third_party.gni")
import("icu.gni")

assert(
    (skia_icu_data_filter == "" && skia_icu_data_filter_patch == "") ||
        (skia_icu_data_filter != "" && skia_icu_data_filter_patch != ""),
    "skia_icu_data_filter and skia_icu_data_filter_patch must be set together")

if (skia_use_system_icu) {
  assert(skia_icu_data_filter == "",
         "skia_icu_data_filter can only be used with bundled ICU")
  system("icu") {
    libs = [ "icuuc" ]
    defines = [ "U_USING_ICU_NAMESPACE=0" ]
  }
} else {
  if (target_cpu == "wasm") {
    data_assembly = "$target_gen_dir/icudtl_dat.cpp"
  } else {
    data_assembly = "$target_gen_dir/icudtl_dat.S"
  }
  data_dir = "../externals/icu/"
  if (target_cpu == "wasm") {
    # Use a super super super stripped down version for wasm,
    # which is the same thing flutter is using.
    data_dir += "flutter"
  } else if (is_android) {
    data_dir += "android"
  } else if (is_ios) {
    data_dir += "ios"
  } else {
    data_dir += "common"
  }

  icu_data_file = "$data_dir/icudtl.dat"
  if (skia_icu_data_filter != "") {
    assert(host_os == "mac" || host_os == "linux" || host_os == "win",
           "ICU data generation requires a macOS, Linux, or Windows host")

    icu_data_file = "$target_gen_dir/icudtl.dat"
    action("generate_icu_data") {
      script = "generate_skiko_icu_data.py"
      inputs = [
        skia_icu_data_filter,
        skia_icu_data_filter_patch,
        "../externals/icu/source/runConfigureICU",
      ]
      outputs = [ icu_data_file ]
      args = [
        "--filter",
        rebase_path(skia_icu_data_filter, root_build_dir),
        "--filter-patch",
        rebase_path(skia_icu_data_filter_patch, root_build_dir),
        "--output",
        rebase_path(icu_data_file, root_build_dir),
        "--build-dir",
        rebase_path("$target_gen_dir/icu_data_build", root_build_dir),
      ]

      if (is_ios || is_tvos) {
        args += [ "--apply-cast-patch" ]
      }
    }
  }

  # JB NOTE: we use _skiko suffix for ICU symbols to avoid the clashes with Apple SDK symbols
  action("make_data_assembly") {
    if (target_cpu == "wasm") {
      _u_icu_version_major_num =
          "_skiko78"  # defined in source/common/unicode/uvernum.h
      script = "make_data_cpp.py"
      inputs = [ icu_data_file ]
      outputs = [ data_assembly ]
      args = [
        "icudt${_u_icu_version_major_num}_dat",
        rebase_path(inputs[0], root_build_dir),
        rebase_path(data_assembly, root_build_dir),
      ]
    } else {
      # The original script was:
      # script = "../externals/icu/scripts/make_data_assembly.py"
      # We can't modify it because it's checked-out from ICU repo for every build.
      # Therefore we have a copy for skiko purposes:
      script = "make_data_assembly_for_skiko.py"
      inputs = [ icu_data_file ]
      outputs = [ "$data_assembly" ]
      args = [
        rebase_path(inputs[0], root_build_dir),
        rebase_path(data_assembly, root_build_dir),
      ]
      if (is_mac || is_ios) {
        args += [ "--mac" ]
      }
    }
    if (skia_icu_data_filter != "") {
      deps = [ ":generate_icu_data" ]
    }
  }

  third_party("headers") {
    public_include_dirs = [
      "../externals/icu/source/common",
      "../externals/icu/source/i18n",
      ".",
    ]
    public_defines = [
      "U_USING_ICU_NAMESPACE=0",
      "U_DISABLE_RENAMING=0",
      "U_HAVE_LIB_SUFFIX=1",
      "U_DISABLE_VERSION_SUFFIX=1",
      "U_LIB_SUFFIX_C_NAME=_skiko",
    ]
  }

  third_party("icu") {
    public_include_dirs = [
      "../externals/icu/source/common",
      "../externals/icu/source/i18n",
      ".",
    ]
    public_defines = [
      "U_USING_ICU_NAMESPACE=0",
      "U_DISABLE_RENAMING=0",
      "SK_USING_THIRD_PARTY_ICU",
      "U_HAVE_LIB_SUFFIX=1",
      "U_DISABLE_VERSION_SUFFIX=1",
      "U_LIB_SUFFIX_C_NAME=_skiko",
    ]
    configs = [ "//gn/portable:add_rtti" ]
    defines = [
      # http://userguide.icu-project.org/howtouseicu
      "U_COMMON_IMPLEMENTATION",
      "U_STATIC_IMPLEMENTATION",
      "U_ENABLE_DYLOAD=0",
      "U_I18N_IMPLEMENTATION",
      "U_DISABLE_RENAMING=0",
      "U_USING_ICU_NAMESPACE=0",

      # If we don't set this to zero, ICU will set it to 600,
      # which makes Macs set _POSIX_C_SOURCE=200112L,
      # which makes Macs set __DARWIN_C_LEVEL=_POSIX_C_SOURCE instead of =__DARWIN_C_FULL,
      # which makes <time.h> not expose timespec_get,
      # which makes recent libc++ <ctime> not #include-able with -std=c++17.
      "_XOPEN_SOURCE=0",
    ]
    if (target_cpu == "wasm") {
      # Tell ICU that we are a 32 bit platform, otherwise,
      # double-conversion-utils.h doesn't know how to operate.
      defines += [ "__i386__" ]
    }
    sources = icu_sources
    if (is_win) {
      deps = [ ":icudata" ]
      public_defines += [
        "U_NOEXCEPT=",
        "U_STATIC_IMPLEMENTATION",
      ]
      libs = [ "Advapi32.lib" ]
      sources += [
        "../externals/icu/source/stubdata/stubdata.cpp",
        "SkLoadICU.cpp",
      ]
    } else {
      sources += [ "$data_assembly" ]
      deps = [ ":make_data_assembly" ]
    }
  }

  icu_data_copy_file = "../externals/icu/common/icudtl.dat"
  if (skia_icu_data_filter != "") {
    icu_data_copy_file = icu_data_file
  }
  copy("icudata") {
    sources = [ icu_data_copy_file ]
    outputs = [ "$root_out_dir/icudtl.dat" ]
    data = [ "$root_out_dir/icudtl.dat" ]
    if (skia_icu_data_filter != "") {
      deps = [ ":generate_icu_data" ]
    }
  }
}
